import("//build/bazel/bazel_inputs.gni")
import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("bin") {
  output_name = "tiling_wm"
  with_unit_tests = true
  edition = "2024"

  deps = [
    ":tiling_wm_config",
    "//sdk/fidl/fuchsia.element:fuchsia.element_rust",
    "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
    "//sdk/fidl/fuchsia.session.scene:fuchsia.session.scene_rust",
    "//sdk/fidl/fuchsia.session.window:fuchsia.session.window_rust",
    "//sdk/fidl/fuchsia.ui.composition:fuchsia.ui.composition_rust",
    "//sdk/fidl/fuchsia.ui.focus:fuchsia.ui.focus_rust",
    "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/ui/fuchsia-scenic",
    "//src/lib/ui/fidl_fuchsia_ui_views_ext:lib",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
  ]

  sources = [
    "src/main.rs",
    "src/observability.rs",
    "src/policy.rs",
  ]
}

fuchsia_component_manifest("tiling_wm_component_manifest") {
  manifest = "meta/tiling_wm.cml"
  component_name = "tiling_wm"
}

fuchsia_structured_config_rust_lib("tiling_wm_config") {
  cm_label = ":tiling_wm_component_manifest"
}

fuchsia_structured_config_values("tiling_wm_config_values") {
  cm_label = ":tiling_wm_component_manifest"
  values_source = "meta/config.json5"
}

fuchsia_component("tiling_wm_component") {
  cm_label = ":tiling_wm_component_manifest"
  deps = [ ":bin" ]
}

fuchsia_package("tiling_wm") {
  package_name = "tiling_wm"
  deps = [
    ":tiling_wm_component",
    ":tiling_wm_component_manifest",
    ":tiling_wm_config_values",
  ]
}


fuchsia_unittest_package("tiling-wm-tests") {
  deps = [ ":bin_test" ]
}


rustc_binary("driver_bin") {
  output_name = "tiling_wm_driver"
  source_root = "src/driver.rs"
  sources = [ "src/driver.rs" ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.session.window:fuchsia.session.window_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component("driver_component") {
  component_name = "tiling_wm_driver"
  manifest = "meta/driver.cml"
  deps = [ ":driver_bin" ]
}

fuchsia_package("driver_package") {
  package_name = "tiling_wm_driver"
  deps = [ ":driver_component" ]
}
