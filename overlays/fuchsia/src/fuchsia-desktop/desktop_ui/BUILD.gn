import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_test.gni")

rustc_library("desktop_ui") {
  name = "desktop_ui"
  with_unit_tests = true
  edition = "2024"
  sources = [
    "src/chrome.rs",
    "src/lib.rs",
    "src/tokens.rs",
  ]
  deps = [
    "//src/fuchsia-desktop/theme_model",
    "//third_party/rust_crates:serde_json",
  ]
  inputs = [ "../theme_catalog/catalog/instrument-studio-dtcg.package.json" ]
}

# Host-visible unit test target used by local gates.

rustc_test("desktop_ui_qualification") {
  name = "desktop_ui_qualification"
  edition = "2024"
  testonly = true
  source_root = "src/qualification.rs"
  sources = [ "src/qualification.rs" ]
  deps = [
    ":desktop_ui",
    "//src/fuchsia-desktop/theme_model",
  ]
  inputs = [ "../theme_catalog/catalog/instrument-studio-dtcg.package.json" ]
}
