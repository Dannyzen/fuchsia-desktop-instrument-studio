import("//build/components.gni")
import("//build/fidl/fidl.gni")
import("//build/rust/rustc_binary.gni")
import("//build/rust/rustc_library.gni")

fidl("fuchsia.instrumentstudio.theme") {
  sources = [ "fidl/theme.fidl" ]
  public_deps = [ "//zircon/vdso/zx" ]
}

rustc_library("theme_service_core") {
  name = "theme_service_core"
  edition = "2024"
  with_unit_tests = true
  source_root = "src/authority.rs"
  sources = [ "src/authority.rs" ]
  inputs = [
    "../theme_model/testdata/native-theme-v1-package.json",
    "testdata/instrument-studio-conflict.package.json",
    "//src/fuchsia-desktop/theme_catalog/catalog/instrument-studio-base16.package.json",
    "//src/fuchsia-desktop/theme_catalog/catalog/instrument-studio-base24.package.json",
    "//src/fuchsia-desktop/theme_catalog/catalog/instrument-studio-dtcg.package.json",
    "//src/fuchsia-desktop/theme_catalog/catalog/instrument-studio-omarchy.package.json",
  ]
  deps = [
    ":fuchsia.instrumentstudio.theme_rust",
    "//sdk/rust/zx-status",
    "//src/fuchsia-desktop/theme_model",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",
    "//third_party/rust_crates:futures",
  ]
  test_deps = [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
  ]
}

rustc_binary("bin") {
  name = "native_theme_service"
  edition = "2024"
  sources = [ "src/main.rs" ]
  inputs = [
    "//src/fuchsia-desktop/theme_catalog/catalog/instrument-studio-base16.package.json",
    "//src/fuchsia-desktop/theme_catalog/catalog/instrument-studio-base24.package.json",
    "//src/fuchsia-desktop/theme_catalog/catalog/instrument-studio-dtcg.package.json",
    "//src/fuchsia-desktop/theme_catalog/catalog/instrument-studio-omarchy.package.json",
  ]
  deps = [
    ":theme_service_core",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_component("component") {
  component_name = "native_theme_service"
  manifest = "meta/native_theme_service.cml"
  deps = [ ":bin" ]
}

fuchsia_package("package") {
  package_name = "native_theme_service"
  deps = [
    ":component",
    "//src/fuchsia-desktop/theme_catalog:catalog_artifacts",
  ]
}
