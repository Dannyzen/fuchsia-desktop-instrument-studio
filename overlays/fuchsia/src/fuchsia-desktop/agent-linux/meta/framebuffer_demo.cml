{
    program: {
        runner: "starnix_container",
        binary: "/bin/sh",
        args: [
            "-c",
            "set +e; {pkg_path}/data/framebuffer-demo; rc=$?; echo $rc > /tmp/framebuffer-demo.status; sleep 300",
        ],
        uid: "0",
    },
}
