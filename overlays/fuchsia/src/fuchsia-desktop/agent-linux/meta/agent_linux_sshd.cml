{
    program: {
        runner: "starnix_container",
        binary: "/bin/sh",
        args: [ "data/agent-linux-init.sh" ],
        environ: [ "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" ],
        uid: "0",
    },
}
